NEXT_PUBLIC_SITE_URL=https://your-domain.example
# Server-only Firebase/GCP settings. In production inject the password hash from
# Secret Manager; do not put a plain password, hash, or token in NEXT_PUBLIC_*.
FIREBASE_PROJECT_ID=tiancinge
FIREBASE_STORAGE_BUCKET=tiancinge.firebasestorage.app
ADMIN_USERNAME=tiancinge
ADMIN_PASSWORD_HASH=scrypt$v1$...
ADMIN_CREDENTIAL_VERSION=1
ADMIN_ALLOWED_ORIGIN=https://tiancinge-admin.web.app
# Optional during MFA enrollment; inject from Secret Manager only after the
# administrator has registered the secret in an authenticator app.
# ADMIN_TOTP_SECRET=BASE32_SECRET
