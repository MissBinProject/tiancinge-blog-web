VITE_WEB_URL=http://localhost:3000
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_APP_ID=your-firebase-app-id

# Server-account migration. Set true only after Cloud Run admin API is deployed.
VITE_ADMIN_AUTH_SERVER=false
# Leave empty on the hosted admin site so requests use the same origin.
# VITE_ADMIN_API_ORIGIN=http://localhost:3000

# Playwright only; never commit a real password.
# E2E_ADMIN_USERNAME=tiancinge
# E2E_ADMIN_PASSWORD=

# Optional local emulators only; leave unset for Firebase production.
# VITE_FIREBASE_AUTH_EMULATOR=http://127.0.0.1:9099
# VITE_FIREBASE_FIRESTORE_EMULATOR=127.0.0.1:8080
